# Script mode (cmake -P): writes OUTPUT, a C++ source defining the embedded shader table consumed by
# Paralax/Renderer/ShaderLibrary.cpp, from the SPIR-V files listed in INPUTS (semicolon-separated).

set(contents "// Generated by cmake/EmbedShaders.cmake. Do not edit.\n#include <cstddef>\n#include <cstdint>\n\nnamespace Paralax::EmbeddedShaders {\n\n")
set(table "")
set(count 0)

foreach(input IN LISTS INPUTS)
	get_filename_component(name "${input}" NAME_WE)
	file(READ "${input}" hex HEX)
	string(LENGTH "${hex}" hex_length)
	math(EXPR byte_count "${hex_length} / 2")
	# Emit as 32-bit-aligned bytes: SPIR-V is consumed as uint32_t words.
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n\t" bytes "${bytes}")
	string(APPEND contents "\talignas(4) static const uint8_t s_${name}[] = {\n\t${bytes}\n\t};\n\n")
	string(APPEND table "\t\t{ \"${name}\", s_${name}, ${byte_count} },\n")
	math(EXPR count "${count} + 1")
endforeach()

string(APPEND contents "\tstruct Entry\n\t{\n\t\tconst char* Name;\n\t\tconst uint8_t* Data;\n\t\tsize_t Size;\n\t};\n\n")
if(count EQUAL 0)
	string(APPEND contents "\textern const Entry* const g_Entries = nullptr;\n\textern const size_t g_EntryCount = 0;\n\n}\n")
else()
	string(APPEND contents "\tstatic const Entry s_Entries[] = {\n${table}\t};\n\n")
	string(APPEND contents "\textern const Entry* const g_Entries = s_Entries;\n\textern const size_t g_EntryCount = ${count};\n\n}\n")
endif()

# Only rewrite when changed, so dependents are not rebuilt needlessly.
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" previous)
	if(previous STREQUAL contents)
		return()
	endif()
endif()
file(WRITE "${OUTPUT}" "${contents}")
