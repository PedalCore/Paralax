# Script mode (cmake -P): writes OUTPUT, a C++ source with a table of embedded files in namespace
# Paralax::${NAMESPACE} (entries of type Paralax::EmbeddedFile, see Paralax/Core/EmbeddedFile.h), from the files
# listed in INPUTS (semicolon-separated). Each entry is named after its file name without extension.

if(NOT NAMESPACE)
	message(FATAL_ERROR "EmbedFiles.cmake: NAMESPACE is required")
endif()

set(contents "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include \"Paralax/Core/EmbeddedFile.h\"\n\nnamespace Paralax::${NAMESPACE} {\n\n")
set(table "")
set(count 0)

foreach(input IN LISTS INPUTS)
	get_filename_component(name "${input}" NAME_WE)
	string(MAKE_C_IDENTIFIER "${name}" identifier)
	file(READ "${input}" hex HEX)
	string(LENGTH "${hex}" hex_length)
	math(EXPR byte_count "${hex_length} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n\t" bytes "${bytes}")
	# 16-byte alignment suits every consumer (SPIR-V words, font tables).
	string(APPEND contents "\talignas(16) static const uint8_t s_${identifier}[] = {\n\t${bytes}\n\t};\n\n")
	string(APPEND table "\t\t{\"${name}\", s_${identifier}, ${byte_count}},\n")
	math(EXPR count "${count} + 1")
endforeach()

if(count EQUAL 0)
	string(APPEND contents "\textern const EmbeddedFile* const g_Entries = nullptr;\n\textern const size_t g_EntryCount = 0;\n\n}\n")
else()
	string(APPEND contents "\tstatic const EmbeddedFile s_Entries[] = {\n${table}\t};\n\n")
	string(APPEND contents "\textern const EmbeddedFile* const g_Entries = s_Entries;\n\textern const size_t g_EntryCount = ${count};\n\n}\n")
endif()

# Only rewrite when changed, so dependents are not rebuilt needlessly.
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" previous)
	if(previous STREQUAL contents)
		return()
	endif()
endif()
file(WRITE "${OUTPUT}" "${contents}")
